DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=banco_de_dados
DB_PORT=3306

N8N_WEBHOOK_URL=http://localhost:5678/webhook/pape

# Origens permitidas pelo CORS (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:3000

# Token de administrador para rotas de escrita (POST/PUT/DELETE /api/projetos).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=troque_por_um_token_forte

# Token interno que protege POST /internal/sync/pipefy-financeiro.
# O agent do fluxo n8n usa este MESMO valor no header X-Internal-Token.
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_SYNC_TOKEN=troque_por_um_token_forte

# Service Account token do Pipefy (PAT esta deprecado).
# Gere em: Members and Permissions -> Service Accounts -> Create Service Account
PIPEFY_TOKEN=cole_o_service_account_token_aqui

